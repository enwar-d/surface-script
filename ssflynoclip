-- Animation Functions
local function animateButtonPress(button)
	local originalSize = button.Size
	button.MouseButton1Down:Connect(function()
		local pressedSize = UDim2.new(
			originalSize.X.Scale,
			originalSize.X.Offset * 0.95,
			originalSize.Y.Scale,
			originalSize.Y.Offset * 0.95
		)

		local tween = TweenService:Create(
			button,
			TweenInfo.new(0.1, EASING_STYLE, EASING_DIRECTION),
			{Size = pressedSize}
		)
		tween:Play()
	end)

	button.MouseButton1Up:Connect(function()
		local tween = TweenService:Create(
			button,
			TweenInfo.new(0.15, EASING_STYLE, EASING_DIRECTION),
			{Size = originalSize}
		)
		tween:Play()
	end)

	button.MouseLeave:Connect(function()
		local tween = TweenService:Create(
			button,
			TweenInfo.new(0.15, EASING_STYLE, EASING_DIRECTION),
			{Size = originalSize}
		)
		tween:Play()
	end)
end

local function animateKnobPress(knob)
	knob.MouseButton1Down:Connect(function()
		local originalSize = knob.Size
		local pressedSize = UDim2.new(0, 14, 0, 14)

		local tween = TweenService:Create(
			knob,
			TweenInfo.new(0.1, EASING_STYLE, EASING_DIRECTION),
			{Size = pressedSize}
		)
		tween:Play()
	end)

	knob.MouseButton1Up:Connect(function()
		local originalSize = knob.Size
		local normalSize = UDim2.new(0, 16, 0, 16)

		local tween = TweenService:Create(
			knob,
			TweenInfo.new(0.15, EASING_STYLE, EASING_DIRECTION),
			{Size = normalSize}
		)
		tween:Play()
	end)
end

