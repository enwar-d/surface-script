		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum.WalkSpeed = GAME_DEFAULT_WALKSPEED end) end

		if noclipEnabled then
			noclipEnabled = false
			stopNoclipLoop()
			noclipToggle.Text = "OFF"
			noclipToggle.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
		end

		cleanupFlyObjects()
		revertBtn.Visible = false
	else
		deactivateBtn.Text = "Deactivate"
		deactivateBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)

		if flyEnabled then
			enableFlyObjects(true)
			revertBtn.Visible = true
		end
	end
end)

