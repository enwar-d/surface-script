					selStroke.Color = COLORS.GlassStrokeColor
					selStroke.Thickness = 1
					selStroke.Transparency = 0.55

					attachSpringPress(selBtn, 0.90, 1.05)

					PlayerCardSelectButtons[plr] = { Button = selBtn }

					selBtn.Activated:Connect(function()
						selectPlayer(plr)
					end)
				end
			end
