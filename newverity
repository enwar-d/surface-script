		TabButtons[tab.Id] = {
			Slot = slot,
			YOffset = yOffset,
		}

		slot.Activated:Connect(function()
			local winScaleObj = MainWindowFrame:FindFirstChildOfClass("UIScale")

			if ActiveTabId == tab.Id then
				-- Clicking the button you are ALREADY on toggles the menu closed/open,
				-- while SlidingActiveBox (the outline on the dock button) NEVER disappears!
				if WindowOpen then
					WindowOpen = false
					updateWorldBlur()
					if winScaleObj then
						TweenService:Create(winScaleObj, IOS_TIMING.PanelClose, { Scale = 0.88 }):Play()
					end
					task.delay(0.24, function()
						if not WindowOpen then
							MainWindowFrame.Visible = false
						end
					end)
				else
					WindowOpen = true
					MainWindowFrame.Visible = true
					-- Return menu back to regular spot when re-selected!
					TweenService:Create(MainWindowFrame, IOS_TIMING.PanelOpen, {
						Position = REGULAR_WINDOW_POS,
					}):Play()
					if winScaleObj then
						TweenService:Create(winScaleObj, IOS_TIMING.PanelOpen, { Scale = 1 }):Play()
					end
					updateWorldBlur()
				end
			else
				-- Selecting another button opens the menu (if closed), returns it to the regular spot, and switches tab
				WindowOpen = true
				MainWindowFrame.Visible = true
				TweenService:Create(MainWindowFrame, IOS_TIMING.PanelOpen, {
					Position = REGULAR_WINDOW_POS,
				}):Play()
				if winScaleObj then
					TweenService:Create(winScaleObj, IOS_TIMING.PanelOpen, { Scale = 1 }):Play()
				end
				selectTab(tab.Id, tab.Title)
				updateWorldBlur()
			end
		end)
	end

