local function loadDatabaseFromUrl(url)
	if type(url) ~= "string" or #url == 0 then
		return false
	end
	local ok, result = pcall(function()
		local raw = game:HttpGet(url)
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(result) == "table" then
		if type(result.Universal) == "table" then
			ScriptDatabase.Universal = result.Universal
		end
		if type(result.Places) == "table" then
			ScriptDatabase.Places = result.Places
		end
		if RefreshScriptsPageFunc then
			RefreshScriptsPageFunc()
		end
		return true
	end
	return false
end

local SurfaceScriptAPI = {
	_ScreenGui = ScreenGui,
	SessionExecuted = false,
	Settings = UISettings,
	PlayerFeatures = PlayerFeatures,
	Database = ScriptDatabase,
	Notify = createNotification,
	SetPanelVisible = setPanelVisible,
	SetHiddenToEdge = setHiddenToEdge,
	SaveSettings = saveSettingsToClient,
	LoadDatabaseFromUrl = loadDatabaseFromUrl,
	RefreshScripts = function()
		if RefreshScriptsPageFunc then
			RefreshScriptsPageFunc()
		end
	end,
	AddUniversalScript = function(name, urlOrCallback)
		local entry = { Name = name }
		if type(urlOrCallback) == "function" then
			entry.Callback = urlOrCallback
		else
			entry.Url = tostring(urlOrCallback)
		end
		table.insert(ScriptDatabase.Universal, entry)
		if RefreshScriptsPageFunc then
			RefreshScriptsPageFunc()
		end
	end,
	AddGameScript = function(placeId, name, urlOrCallback)
		local key = tostring(placeId)
		ScriptDatabase.Places[key] = ScriptDatabase.Places[key] or {}
		local entry = { Name = name }
		if type(urlOrCallback) == "function" then
			entry.Callback = urlOrCallback
		else
			entry.Url = tostring(urlOrCallback)
		end
		table.insert(ScriptDatabase.Places[key], entry)
		if RefreshScriptsPageFunc then
			RefreshScriptsPageFunc()
		end
	end,
	TogglePanel = function()
		if DockHiddenToEdge then
			setHiddenToEdge(false)
		else
			setPanelVisible(not SuiteVisible)
		end
	end,
}

function SurfaceScriptAPI.ExecuteSession(forceFirstTime)
	if forceFirstTime then
		SurfaceScriptAPI.SessionExecuted = false
		setPanelVisible(false)
	end

	if not SurfaceScriptAPI.SessionExecuted then
		createNotification({
			Title = "Confirm action?",
			Subtitle = "Execute game script",
			Type = "Confirm",
			OnConfirm = function()
				SurfaceScriptAPI.SessionExecuted = true
				setPanelVisible(true)
			end,
			OnCancel = function()
			end,
		})
	else
		setPanelVisible(true)
		createNotification({
			Title = "Surface Script",
			Subtitle = "Want to load everything?",
			Type = "Regular",
		})
	end
end

_G.SurfaceScript = SurfaceScriptAPI
shared.SurfaceScript = SurfaceScriptAPI
pcall(function()
	if type(getgenv) == "function" then
		getgenv().SurfaceScript = SurfaceScriptAPI
	end
end)

if type(DATABASE_URL) == "string" and #DATABASE_URL > 0 then
	task.spawn(function()
		loadDatabaseFromUrl(DATABASE_URL)
	end)
end

task.delay(0.4, function()
	SurfaceScriptAPI.ExecuteSession(true)
end)
