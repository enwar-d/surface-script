--[[
	SURFACE SCRIPT - iOS Notification & Executor UI Shell
	Compatible with Roblox Studio & Script Executors (gethui / CoreGui / PlayerGui)
	- Persists across player death/respawn (ResetOnSpawn = false + singleton guard + CharacterAdded re-apply)
	- Saves client settings automatically (writefile/readfile JSON + Studio Attribute fallback)
	- Supports remote/local Script Database for Universal & Place-specific scripts
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")
local AssetService = game:GetService("AssetService")

local LocalPlayer = Players.LocalPlayer

-- Resolve safe UI parent for both Executors and Studio
local function getGuiParent()
	local ok, hui = pcall(function()
		if type(gethui) == "function" then
			return gethui()
		end
		return nil
	end)
	if ok and hui then
		return hui
	end
	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local testOk = pcall(function()
			local f = Instance.new("Folder")
			f.Parent = coreGui
			f:Destroy()
		end)
		if testOk then
			return coreGui
		end
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local guiParent = getGuiParent()

-- Prevent resetting when player dies if script is placed in StarterGui
if _G.SurfaceScript and _G.SurfaceScript._ScreenGui and _G.SurfaceScript._ScreenGui.Parent then
	if script and script.Parent and script.Parent:IsA("PlayerGui") then
		-- A duplicate LocalScript was cloned on respawn; destroy the duplicate so the active UI never resets
		pcall(function()
			script:Destroy()
		end)
		return
	end
end

local existingGui = guiParent:FindFirstChild("SurfaceScriptUI")
if existingGui then
	existingGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SurfaceScriptUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.DisplayOrder = 999
ScreenGui.Parent = guiParent

-- Move LocalScript inside ResetOnSpawn=false ScreenGui so Roblox never destroys/stops it on character death
pcall(function()
	if script and script:IsA("LocalScript") and script.Parent and script.Parent:IsA("PlayerGui") then
		script.Parent = ScreenGui
	end
end)

--------------------------------------------------------------------------------
-- CLIENT SETTINGS PERSISTENCE (writefile/readfile + Studio Attribute Fallback)
--------------------------------------------------------------------------------
local SETTINGS_FILE_NAME = "SurfaceScript_Settings.json"

local UISettings = {
	GlassUI = true,
	BackgroundBlur = true,
	SwipeToDismiss = true,
	CompactNotifications = false,
}

local function loadSavedSettings()
	local loadedTable = nil

	-- 1. Try Executor filesystem (isfile / readfile)
	pcall(function()
		if type(isfile) == "function" and type(readfile) == "function" then
			if isfile(SETTINGS_FILE_NAME) then
				local raw = readfile(SETTINGS_FILE_NAME)
				if type(raw) == "string" and #raw > 0 then
					loadedTable = HttpService:JSONDecode(raw)
				end
			end
		end
	end)

	-- 2. Fallback to LocalPlayer / Lighting Attribute or _G (for Studio & non-fs environments)
	if type(loadedTable) ~= "table" then
		pcall(function()
			local attr = (LocalPlayer and LocalPlayer:GetAttribute("SurfaceScript_Settings"))
				or Lighting:GetAttribute("SurfaceScript_Settings")
			if type(attr) == "string" and #attr > 0 then
				loadedTable = HttpService:JSONDecode(attr)
			elseif type(_G.SurfaceSavedSettings) == "table" then
				loadedTable = _G.SurfaceSavedSettings
			end
		end)
	end

	if type(loadedTable) == "table" then
		for k, v in pairs(loadedTable) do
			if UISettings[k] ~= nil and type(v) == "boolean" then
				UISettings[k] = v
			end
		end
	end
end

local function saveSettingsToClient()
	local copy = {
		GlassUI = UISettings.GlassUI,
		BackgroundBlur = UISettings.BackgroundBlur,
		SwipeToDismiss = UISettings.SwipeToDismiss,
		CompactNotifications = UISettings.CompactNotifications,
	}
	_G.SurfaceSavedSettings = copy

	local okJson, encoded = pcall(function()
		return HttpService:JSONEncode(copy)
	end)
	if not okJson or type(encoded) ~= "string" then
		return
	end

	-- Save to Executor filesystem if available
	pcall(function()
		if type(writefile) == "function" then
			writefile(SETTINGS_FILE_NAME, encoded)
		end
	end)

	-- Also save to Player/Lighting Attributes so Studio sessions persist across runs/respawns
	pcall(function()
		if LocalPlayer then
			LocalPlayer:SetAttribute("SurfaceScript_Settings", encoded)
		end
		Lighting:SetAttribute("SurfaceScript_Settings", encoded)
	end)
end

loadSavedSettings()

