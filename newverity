						return
					end
					local targetRoot = SelectedTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
					local myRoot = LocalPlayer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
