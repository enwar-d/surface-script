		Players.PlayerAdded:Connect(function()
			task.wait(0.1)
			rebuildPlayerCards()
		end)
		Players.PlayerRemoving:Connect(function(plr)
			if SelectedTargetPlayer == plr then
				SelectedTargetPlayer = nil
				if SpectatingTarget and actionControllers["Spectate Player"] then
					actionControllers["Spectate Player"].SetState(false, false)
				end
				if FollowingTarget and actionControllers["Follow Player"] then
					actionControllers["Follow Player"].SetState(false, false)
				end
				cleanupHighlight()
			end
			task.wait(0.05)
			rebuildPlayerCards()
		end)

		rebuildPlayerCards()

		TabPages["Players"] = pageWrap
		return pageWrap
	end

