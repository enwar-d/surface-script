-- Execute a script entry (URL, source string, or Lua function)
local function executeScriptEntry(entry)
	if not entry then return end
	createNotification({
		Title = entry.Name or "Script Executed",
		Subtitle = "Running script...",
		Type = "Regular",
		Duration = 2.4,
	})

	task.spawn(function()
		if type(entry.Callback) == "function" then
			pcall(entry.Callback)
		elseif type(entry.Source) == "string" and #entry.Source > 0 then
			pcall(function()
				local fn = loadstring(entry.Source)
				if fn then fn() end
			end)
		elseif type(entry.Url) == "string" and #entry.Url > 0 then
			pcall(function()
				local body = game:HttpGet(entry.Url)
				if type(body) == "string" and #body > 0 then
					local fn = loadstring(body)
					if fn then fn() end
				end
			end)
		end
	end)
end

