-- THEME REGISTRY (Switches seamlessly between Glass UI and Normal UI, with
-- uniform non-cutout outlines!)
--------------------------------------------------------------------------------
local ThemedSurfaces = {} -- { { Frame, Stroke, Kind = "Window" | "Card" } }

local function registerThemedSurface(frame, cornerRadius, kind)
	frame.BorderSizePixel = 0
	if cornerRadius then
		local corner = frame:FindFirstChildOfClass("UICorner") or Instance.new("UICorner", frame)
		corner.CornerRadius = cornerRadius
	end

	-- Uniform continuous UIStroke (no UIGradient transparency cutout!)
	local stroke = frame:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", frame)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Thickness = 1.2

	local entry = { Frame = frame, Stroke = stroke, Kind = kind or "Window" }
	table.insert(ThemedSurfaces, entry)

	local isGlass = UISettings.GlassUI
	if entry.Kind == "Window" then
		frame.BackgroundColor3 = isGlass and COLORS.GlassWindowBg or COLORS.NormalWindowBg
		frame.BackgroundTransparency = isGlass and 0.22 or 0
		stroke.Color = isGlass and COLORS.GlassStrokeColor or COLORS.StrokeColor
		stroke.Transparency = isGlass and 0.45 or 0.35
	else
		frame.BackgroundColor3 = isGlass and COLORS.GlassCardBg or COLORS.NormalCardBg
		frame.BackgroundTransparency = isGlass and 0.32 or 0
		stroke.Color = isGlass and COLORS.GlassStrokeColor or COLORS.StrokeColor
		stroke.Transparency = isGlass and 0.55 or 0.45
	end

	return stroke
end

local function refreshTheme()
	local isGlass = UISettings.GlassUI
	for _, entry in ipairs(ThemedSurfaces) do
		if entry.Frame and entry.Frame.Parent then
			if entry.Kind == "Window" then
				TweenService:Create(entry.Frame, IOS_TIMING.SwitchToggle, {
					BackgroundColor3 = isGlass and COLORS.GlassWindowBg or COLORS.NormalWindowBg,
					BackgroundTransparency = isGlass and 0.22 or 0,
				}):Play()
				TweenService:Create(entry.Stroke, IOS_TIMING.SwitchToggle, {
					Color = isGlass and COLORS.GlassStrokeColor or COLORS.StrokeColor,
					Transparency = isGlass and 0.45 or 0.35,
				}):Play()
			else
				TweenService:Create(entry.Frame, IOS_TIMING.SwitchToggle, {
					BackgroundColor3 = isGlass and COLORS.GlassCardBg or COLORS.NormalCardBg,
					BackgroundTransparency = isGlass and 0.32 or 0,
				}):Play()
				TweenService:Create(entry.Stroke, IOS_TIMING.SwitchToggle, {
					Color = isGlass and COLORS.GlassStrokeColor or COLORS.StrokeColor,
					Transparency = isGlass and 0.55 or 0.45,
				}):Play()
			end
		end
	end
end

-- Helper: Add tactile iOS spring press-and-release animation to any button
local function attachSpringPress(button, downScale, upScale)
	downScale = downScale or 0.90
	upScale = upScale or 1.05
	local scaleObj = button:FindFirstChildOfClass("UIScale")
	if not scaleObj then
		scaleObj = Instance.new("UIScale")
		scaleObj.Scale = 1
		scaleObj.Parent = button
	end

	button.MouseButton1Down:Connect(function()
		TweenService:Create(scaleObj, IOS_TIMING.PressDown, { Scale = downScale }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scaleObj, IOS_TIMING.PressDown, { Scale = upScale }):Play()
		task.delay(0.09, function()
			if scaleObj.Parent then
				TweenService:Create(scaleObj, IOS_TIMING.SpringRelease, { Scale = 1 }):Play()
			end
		end)
	end)
	button.MouseLeave:Connect(function()
		if scaleObj.Parent and scaleObj.Scale ~= 1 then
			TweenService:Create(scaleObj, IOS_TIMING.SpringRelease, { Scale = 1 }):Play()
		end
	end)
	return scaleObj
end

