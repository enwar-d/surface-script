			if server.playing < server.maxPlayers and server.id ~= game.JobId then
				table.insert(servers, server.id)
			end
		end

		if #servers > 0 then
			local randomServer = servers[math.random(1, #servers)]
			showNotification("Server Hop", "Joining new server...")
			game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, randomServer)
		else
			showNotification("Server Hop", "No available servers found")
		end
	else
		showNotification("Server Hop", "Failed to get server list")
	end
end, "Hop to a different server", {"hop", "rejoin"})

------------------------------------------------
-- COMMAND BAR INPUT HANDLING
------------------------------------------------
commandBar.FocusLost:Connect(function(enterPressed)
	if enterPressed and commandBar.Text ~= "" then
		playButtonSound()
		local input = commandBar.Text

		-- Remove prefix if present
		if input:sub(1, 1) == commandPrefix then
			input = input:sub(2)
		end

		local split = {}
		for word in input:gmatch("%S+") do
			table.insert(split, word)
		end

		if #split > 0 then
			table.insert(commandHistory, input)
			commandIndex = #commandHistory + 1

			local cmd = table.remove(split, 1)
			local commandName = cmd:lower()
			local command = commands[commandName] or commands[aliases[commandName]]

			if command then
				local success, err = pcall(function()
					command.func(split)
				end)
				if not success then
					showNotification("Error", "Command error: " .. tostring(err))
				end
			else
				showNotification("Error", "Unknown command: " .. cmd)
			end
		end
		commandBar.Text = ""
	end
end)

-- Keyboard shortcuts for command bar
if not IS_MOBILE then
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Semicolon then
			commandBar:CaptureFocus()
		elseif input.KeyCode == Enum.KeyCode.Up then
			if commandIndex > 1 then
				commandIndex = commandIndex - 1
				commandBar.Text = commandHistory[commandIndex]
			end
		elseif input.KeyCode == Enum.KeyCode.Down then
			if commandIndex < #commandHistory then
				commandIndex = commandIndex + 1
				commandBar.Text = commandHistory[commandIndex]
			elseif commandIndex == #commandHistory then
				commandIndex = #commandHistory + 1
				commandBar.Text = ""
			end
		end
	end)
end

