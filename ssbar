local activeNotifications = {}
local notificationYOffset = 20
local notificationSpacing = 110

local function showNotification(header, message)
	playNotificationSound()

	local notificationIndex = #activeNotifications
	local targetY = notificationYOffset + (notificationIndex * notificationSpacing)

	local notification = Instance.new("Frame")
	notification.Size = UDim2.new(0, 340, 0, 90)
	notification.Position = UDim2.new(1, 350, 0, targetY)
	notification.AnchorPoint = Vector2.new(1, 0)
	notification.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	notification.BackgroundTransparency = 0.2
	notification.Parent = gui
	notification.ZIndex = 10

	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 12)
	uiCorner.Parent = notification

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(70, 70, 70)
	stroke.Thickness = 1
	stroke.Parent = notification

	local headerLabel = Instance.new("TextLabel")
	headerLabel.Size = UDim2.new(1, -50, 0, 28)
	headerLabel.Position = UDim2.new(0, 12, 0, 10)
	headerLabel.BackgroundTransparency = 1
	headerLabel.Text = header
	headerLabel.Font = Enum.Font.GothamBold
	headerLabel.TextSize = 16
	headerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	headerLabel.TextXAlignment = Enum.TextXAlignment.Left
	headerLabel.TextYAlignment = Enum.TextYAlignment.Center
	headerLabel.Parent = notification
	headerLabel.ZIndex = 11

	local messageLabel = Instance.new("TextLabel")
	messageLabel.Size = UDim2.new(1, -24, 0, 42)
	messageLabel.Position = UDim2.new(0, 12, 0, 40)
	messageLabel.BackgroundTransparency = 1
	messageLabel.TextWrapped = true
	messageLabel.Text = message
	messageLabel.Font = Enum.Font.Gotham
	messageLabel.TextSize = 13
	messageLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	messageLabel.TextXAlignment = Enum.TextXAlignment.Left
	messageLabel.TextYAlignment = Enum.TextYAlignment.Top
	messageLabel.Parent = notification
	messageLabel.ZIndex = 11

	local closeNotif = Instance.new("TextButton")
	closeNotif.Size = UDim2.new(0, 28, 0, 28)
	closeNotif.Position = UDim2.new(1, -36, 0, 10)
	closeNotif.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	closeNotif.Text = "×"
	closeNotif.Font = Enum.Font.GothamBold
	closeNotif.TextSize = 22
	closeNotif.TextColor3 = Color3.new(1, 1, 1)
	closeNotif.Parent = notification
	closeNotif.ZIndex = 11

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 8)
	closeCorner.Parent = closeNotif

	closeNotif.MouseEnter:Connect(function()
		TweenService:Create(closeNotif, TweenInfo.new(0.15), {
			BackgroundColor3 = Color3.fromRGB(90, 90, 90)
		}):Play()
	end)

	closeNotif.MouseLeave:Connect(function()
		TweenService:Create(closeNotif, TweenInfo.new(0.15), {
			BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		}):Play()
	end)

	local function removeNotification()
		TweenService:Create(notification, TweenInfo.new(0.35, Enum.EasingStyle.Quint), {
			Position = UDim2.new(1, 350, 0, targetY),
			BackgroundTransparency = 1
		}):Play()

		task.wait(0.35)
		notification:Destroy()

		for i, notif in ipairs(activeNotifications) do
			if notif == notification then
				table.remove(activeNotifications, i)
				break
			end
		end

		for i, notif in ipairs(activeNotifications) do
			local newY = notificationYOffset + ((i-1) * notificationSpacing)
			TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
				Position = UDim2.new(1, -20, 0, newY)
			}):Play()
		end
	end

	closeNotif.MouseButton1Click:Connect(removeNotification)

	table.insert(activeNotifications, notification)

	TweenService:Create(notification, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, -20, 0, targetY)
	}):Play()

	local autoClose = task.delay(7, function()
		if notification and notification.Parent then
			removeNotification()
		end
	end)

	return notification
end

