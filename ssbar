local function openPopup(name, titleText, build)
	if activePopupName == name then
		closeActivePopup()
		return
	end

	closeActivePopup()
	activePopupName = name
	blur.Size = 18

	local p = Instance.new("Frame")
	p.Size = UDim2.new(0,440,0,360)
	p.Position = UDim2.new(0.5,0,0.5,30)
	p.AnchorPoint = Vector2.new(0.5,0.5)
	p.BackgroundColor3 = Color3.fromRGB(30,30,30)
	p.BackgroundTransparency = 0.25
	p.Parent = gui
	Instance.new("UICorner", p).CornerRadius = UDim.new(0,22)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1,-30,0,40)
	title.Position = UDim2.new(0,15,0,15)
	title.BackgroundTransparency = 1
	title.Text = titleText
	title.Font = Enum.Font.GothamBold
	title.TextSize = 22
	title.TextColor3 = Color3.new(1,1,1)
	title.Parent = p

	build(p)

	TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Quint), {
		Position = UDim2.new(0.5,0,0.5,0)
	}):Play()

	activePopup = p
end

